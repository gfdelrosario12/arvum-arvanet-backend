# =============================================================================
# Mosquitto Access Control Lists (ACLs) - ArvaCore IoT Core Platform
# Restricts topics per node identity, separating node uplinks from backend commands
# =============================================================================

# --- Backend Administrative Client (Full Read/Write) ---
user aquaflow-backend
topic readwrite arvacore/#
topic readwrite arvacore/v1/devices/#
topic readwrite node/#
topic readwrite sensor/#
topic readwrite device/#
topic readwrite actuator/#
topic read $SYS/#

# --- ARVANODE-001 ---
user node_arvanode_001
topic write arvacore/v1/devices/ARVANODE-001/telemetry
topic write arvacore/v1/devices/ARVANODE-001/status
topic write arvacore/v1/devices/ARVANODE-001/events
topic write arvacore/v1/devices/ARVANODE-001/command-results
topic read arvacore/v1/devices/ARVANODE-001/commands
# Backward compatibility topics
topic write node/ARVANODE-001/telemetry
topic write node/ARVANODE-001/event

